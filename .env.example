# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash,gemini-3.5-flash-lite
# gemini | fake (fake = scripted offline responses for sample_repo)
LLM_PROVIDER=gemini
MAX_ATTEMPTS=5
TEST_TIMEOUT=300
# How many project environments (venvs) are kept. Beyond this the least recently used idle one is deleted.
MAX_CACHED_VENVS=10
# Where projects/ and data/ are kept. Empty = this folder.
CODEFIX_HOME=
